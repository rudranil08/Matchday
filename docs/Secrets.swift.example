// Copy this file to Shared/Secrets.swift and fill in your own values.
// Shared/Secrets.swift is git-ignored, so your keys stay on your Mac.
// Leave a value empty to turn that feature off: the app runs with all of them empty.
enum Secrets {
    /// Optional: API-Football key for the live injury list (https://dashboard.api-football.com).
    static let apiFootballKey = ""

    /// Optional: Google sign-in. An iOS OAuth client ID from Google Cloud Console
    /// (APIs & Services › Credentials › Create credentials › OAuth client ID › iOS,
    /// bundle ID com.matchday.app). Looks like "1234567890-abc123.apps.googleusercontent.com".
    static let googleClientID = ""

    /// Optional: email accounts, password reset and the Games leaderboard.
    /// A free Firebase project (https://console.firebase.google.com):
    /// Project settings › General › Project ID and Web API key (starts with "AIza").
    static let firebaseProjectID = ""
    static let firebaseAPIKey = ""
}
